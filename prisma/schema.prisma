generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  STAFF
  CUSTOMER

  @@map("user_role")
}

enum ProductType {
  SOFTWARE
  SERVICE
  ADDON
  PHYSICAL

  @@map("product_type")
}

enum BillingInterval {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY

  @@map("billing_interval")
}

enum SubscriptionStatus {
  DRAFT
  QUOTATION
  CONFIRMED
  ACTIVE
  PAUSED
  CLOSED

  @@map("subscription_status")
}

enum InvoiceStatus {
  DRAFT
  CONFIRMED
  PAID
  CANCELLED
  OVERDUE

  @@map("invoice_status")
}

enum PaymentMethod {
  BANK_TRANSFER
  CREDIT_CARD
  UPI
  CHEQUE
  CASH

  @@map("payment_method")
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT

  @@map("discount_type")
}

enum DiscountTarget {
  WHOLE_SUBSCRIPTION
  SPECIFIC_PRODUCTS

  @@map("discount_target")
}

model User {
  id               String    @id @default(uuid()) @db.Uuid
  email            String    @unique @db.VarChar(255)
  passwordHash     String    @map("password_hash") @db.VarChar(255)
  firstName        String    @map("first_name") @db.VarChar(100)
  lastName         String    @map("last_name") @db.VarChar(100)
  role             UserRole  @default(CUSTOMER)
  resetToken       String?   @map("reset_token") @db.VarChar(255)
  resetTokenExpiry DateTime? @map("reset_token_expiry") @db.Timestamptz(6)
  isActive         Boolean   @default(true) @map("is_active")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  customer         Customer?
  paymentsRecorded Payment[]  @relation("PaymentRecordedBy")
  auditLogs        AuditLog[]

  @@map("users")
}

model Customer {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String?  @unique @map("user_id") @db.Uuid
  companyName      String   @map("company_name") @db.VarChar(255)
  contactName      String   @map("contact_name") @db.VarChar(255)
  email            String   @db.VarChar(255)
  phone            String?  @db.VarChar(50)
  billingAddress   String?  @map("billing_address") @db.Text
  paymentTermsDays Int      @default(30) @map("payment_terms_days")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user          User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  subscriptions Subscription[]
  invoices      Invoice[]

  @@map("customers")
}

model Product {
  id         String      @id @default(uuid()) @db.Uuid
  name       String      @db.VarChar(255)
  type       ProductType @default(SOFTWARE)
  salesPrice Decimal     @default(0) @map("sales_price") @db.Decimal(12, 2)
  costPrice  Decimal     @default(0) @map("cost_price") @db.Decimal(12, 2)
  notes      String?     @db.Text
  isActive   Boolean     @default(true) @map("is_active")
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  variants               ProductVariant[]
  discountRuleProducts   DiscountRuleProduct[]
  quotationTemplateLines QuotationTemplateLine[]
  subscriptionLines      SubscriptionLine[]
  invoiceLines           InvoiceLine[]

  @@map("products")
}

model ProductVariant {
  id             String   @id @default(uuid()) @db.Uuid
  productId      String   @map("product_id") @db.Uuid
  attributeName  String   @map("attribute_name") @db.VarChar(100)
  attributeValue String   @map("attribute_value") @db.VarChar(100)
  priceExtra     Decimal  @default(0) @map("price_extra") @db.Decimal(12, 2)
  sku            String?  @unique @db.VarChar(100)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  product                Product                 @relation(fields: [productId], references: [id], onDelete: Cascade)
  quotationTemplateLines QuotationTemplateLine[]
  subscriptionLines      SubscriptionLine[]

  @@map("product_variants")
}

model SubscriptionPlan {
  id              String          @id @default(uuid()) @db.Uuid
  name            String          @db.VarChar(255)
  code            String          @unique @db.VarChar(50)
  interval        BillingInterval @default(MONTHLY)
  intervalCount   Int             @default(1) @map("interval_count")
  basePrice       Decimal         @default(0) @map("base_price") @db.Decimal(12, 2)
  minQuantity     Int             @default(1) @map("min_quantity")
  startDate       DateTime        @map("start_date") @db.Date
  endDate         DateTime?       @map("end_date") @db.Date
  autoClose       Boolean         @default(false) @map("auto_close")
  allowEarlyClose Boolean         @default(true) @map("allow_early_close")
  allowPause      Boolean         @default(true) @map("allow_pause")
  allowRenew      Boolean         @default(true) @map("allow_renew")
  isActive        Boolean         @default(true) @map("is_active")
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  quotationTemplates QuotationTemplate[]
  subscriptions      Subscription[]

  @@map("subscription_plans")
}

model TaxRule {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(100)
  ratePercent Decimal  @map("rate_percent") @db.Decimal(5, 2)
  isCompound  Boolean  @default(false) @map("is_compound")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  subscriptionLines SubscriptionLine[]

  @@map("tax_rules")
}

model DiscountRule {
  id                String         @id @default(uuid()) @db.Uuid
  code              String         @unique @db.VarChar(50)
  name              String         @db.VarChar(255)
  type              DiscountType   @default(PERCENTAGE)
  value             Decimal        @db.Decimal(12, 2)
  minPurchaseAmount Decimal?       @default(0) @map("min_purchase_amount") @db.Decimal(12, 2)
  minQuantity       Int?           @default(1) @map("min_quantity")
  startDate         DateTime       @map("start_date") @db.Date
  endDate           DateTime       @map("end_date") @db.Date
  maxUsageCount     Int?           @map("max_usage_count")
  currentUsageCount Int            @default(0) @map("current_usage_count")
  appliesTo         DiscountTarget @default(WHOLE_SUBSCRIPTION) @map("applies_to")
  isActive          Boolean        @default(true) @map("is_active")
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  products          DiscountRuleProduct[]
  subscriptionLines SubscriptionLine[]

  @@map("discount_rules")
}

model DiscountRuleProduct {
  discountRuleId String @map("discount_rule_id") @db.Uuid
  productId      String @map("product_id") @db.Uuid

  discountRule DiscountRule @relation(fields: [discountRuleId], references: [id], onDelete: Cascade)
  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([discountRuleId, productId])
  @@map("discount_rule_products")
}

model QuotationTemplate {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @db.VarChar(255)
  planId       String   @map("plan_id") @db.Uuid
  validityDays Int      @default(15) @map("validity_days")
  notes        String?  @db.Text
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  plan  SubscriptionPlan        @relation(fields: [planId], references: [id])
  lines QuotationTemplateLine[]

  @@map("quotation_templates")
}

model QuotationTemplateLine {
  id              String @id @default(uuid()) @db.Uuid
  templateId      String @map("template_id") @db.Uuid
  productId       String @map("product_id") @db.Uuid
  variantId       String? @map("variant_id") @db.Uuid
  defaultQuantity Int    @default(1) @map("default_quantity")

  template QuotationTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  product  Product           @relation(fields: [productId], references: [id])
  variant  ProductVariant?   @relation(fields: [variantId], references: [id])

  @@map("quotation_template_lines")
}

model Subscription {
  id                  String             @id @default(uuid()) @db.Uuid
  subscriptionNumber  String             @unique @map("subscription_number") @db.VarChar(50)
  customerId          String             @map("customer_id") @db.Uuid
  planId              String             @map("plan_id") @db.Uuid
  status              SubscriptionStatus @default(DRAFT)
  startDate           DateTime           @map("start_date") @db.Date
  expiryDate          DateTime?          @map("expiry_date") @db.Date
  nextBillingDate     DateTime?          @map("next_billing_date") @db.Date
  quotationValidUntil DateTime?          @map("quotation_valid_until") @db.Date
  paymentTermsDays    Int                @default(30) @map("payment_terms_days")
  subtotal            Decimal            @default(0) @map("subtotal") @db.Decimal(12, 2)
  taxTotal            Decimal            @default(0) @map("tax_total") @db.Decimal(12, 2)
  discountTotal       Decimal            @default(0) @map("discount_total") @db.Decimal(12, 2)
  grandTotal          Decimal            @default(0) @map("grand_total") @db.Decimal(12, 2)
  currency            String             @default("INR") @db.VarChar(10)
  notes               String?            @db.Text
  createdAt           DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  customer Customer           @relation(fields: [customerId], references: [id])
  plan     SubscriptionPlan   @relation(fields: [planId], references: [id])
  lines    SubscriptionLine[]
  invoices Invoice[]

  @@index([status, nextBillingDate], map: "idx_sub_status_next_billing")
  @@index([customerId, status], map: "idx_sub_customer_status")
  @@index([planId], map: "idx_sub_plan")
  @@map("subscriptions")
}

model SubscriptionLine {
  id             String  @id @default(uuid()) @db.Uuid
  subscriptionId String  @map("subscription_id") @db.Uuid
  productId      String  @map("product_id") @db.Uuid
  variantId      String? @map("variant_id") @db.Uuid
  taxRuleId      String? @map("tax_rule_id") @db.Uuid
  discountRuleId String? @map("discount_rule_id") @db.Uuid
  quantity       Int     @default(1)
  unitPrice      Decimal @map("unit_price") @db.Decimal(12, 2)
  taxAmount      Decimal @default(0) @map("tax_amount") @db.Decimal(12, 2)
  discountAmount Decimal @default(0) @map("discount_amount") @db.Decimal(12, 2)
  lineTotal      Decimal @default(0) @map("line_total") @db.Decimal(12, 2)

  subscription Subscription  @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  product      Product       @relation(fields: [productId], references: [id])
  variant      ProductVariant? @relation(fields: [variantId], references: [id])
  taxRule      TaxRule?      @relation(fields: [taxRuleId], references: [id])
  discountRule DiscountRule? @relation(fields: [discountRuleId], references: [id])

  @@map("subscription_lines")
}

model Invoice {
  id             String        @id @default(uuid()) @db.Uuid
  invoiceNumber  String        @unique @map("invoice_number") @db.VarChar(50)
  subscriptionId String?       @map("subscription_id") @db.Uuid
  customerId     String        @map("customer_id") @db.Uuid
  status         InvoiceStatus @default(DRAFT)
  issueDate      DateTime      @map("issue_date") @db.Date
  dueDate        DateTime      @map("due_date") @db.Date
  periodStart    DateTime?     @map("period_start") @db.Date
  periodEnd      DateTime?     @map("period_end") @db.Date
  subtotal       Decimal       @default(0) @map("subtotal") @db.Decimal(12, 2)
  taxTotal       Decimal       @default(0) @map("tax_total") @db.Decimal(12, 2)
  discountTotal  Decimal       @default(0) @map("discount_total") @db.Decimal(12, 2)
  grandTotal     Decimal       @default(0) @map("grand_total") @db.Decimal(12, 2)
  amountPaid     Decimal       @default(0) @map("amount_paid") @db.Decimal(12, 2)
  balanceDue     Decimal       @default(0) @map("balance_due") @db.Decimal(12, 2)
  idempotencyKey String?       @unique @map("idempotency_key") @db.VarChar(128)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  customer     Customer      @relation(fields: [customerId], references: [id])
  lines        InvoiceLine[]
  payments     Payment[]

  @@index([status, dueDate], map: "idx_inv_status_due_date")
  @@index([customerId], map: "idx_inv_customer")
  @@index([subscriptionId], map: "idx_inv_subscription")
  @@index([idempotencyKey], map: "idx_inv_idempotency")
  @@map("invoices")
}

model InvoiceLine {
  id             String  @id @default(uuid()) @db.Uuid
  invoiceId      String  @map("invoice_id") @db.Uuid
  productId      String  @map("product_id") @db.Uuid
  description    String  @db.VarChar(255)
  quantity       Int     @default(1)
  unitPrice      Decimal @map("unit_price") @db.Decimal(12, 2)
  taxAmount      Decimal @default(0) @map("tax_amount") @db.Decimal(12, 2)
  discountAmount Decimal @default(0) @map("discount_amount") @db.Decimal(12, 2)
  lineTotal      Decimal @default(0) @map("line_total") @db.Decimal(12, 2)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@map("invoice_lines")
}

model Payment {
  id            String        @id @default(uuid()) @db.Uuid
  paymentNumber String        @unique @map("payment_number") @db.VarChar(50)
  invoiceId     String        @map("invoice_id") @db.Uuid
  paymentDate   DateTime      @default(now()) @map("payment_date") @db.Date
  amount        Decimal       @db.Decimal(12, 2)
  method        PaymentMethod @default(BANK_TRANSFER)
  referenceNote String?       @map("reference_note") @db.Text
  recordedById  String?       @map("recorded_by") @db.Uuid
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  invoice    Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  recordedBy User?   @relation("PaymentRecordedBy", fields: [recordedById], references: [id])

  @@index([invoiceId], map: "idx_payment_invoice")
  @@map("payments")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  entityName String   @map("entity_name") @db.VarChar(50)
  entityId   String   @map("entity_id") @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String   @db.VarChar(100)
  message    String   @db.Text
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  actor User? @relation(fields: [actorId], references: [id])

  @@index([entityName, entityId], map: "idx_audit_entity")
  @@map("audit_logs")
}
